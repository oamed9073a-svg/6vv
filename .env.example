# Токен доступа сообщества ВК.
# Получить: Сообщество → Управление → Работа с API → Ключи доступа.
# Нужны права: "Сообщения сообщества".
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxx

# ID сообщества (число без знака минус).
VK_GROUP_ID=123456789

# ID администраторов через запятую (личные id ВК).
# Им приходят уведомления о записях и доступно меню администрирования.
VK_ADMIN_IDS=12345678

# Название салона (используется в текстах бота).
SALON_NAME=Маникюрный салон «Идеал»

# Путь к файлу базы данных (необязательно).
DB_PATH=salon.db
